// TEST FIXTURE — not a host declaration.
//
// The real `clean-cli` contract lives at `host.wit` in the clean-cli
// repository, which is the authoritative declaration under HCV-02. This file
// is a copy of the parts of it the framework's tests exercise, kept here so
// the suite does not depend on a sibling repository being checked out.
//
// It is a strict subset in one respect only: the named-subcommand `cli` world
// is declared here but not in clean-cli's host.wit, because that build does
// not implement it. The framework still needs `world cli` to exist, because
// `wasm32-cli` maps to the world name `cli` (Platform 07 §7.2) and the Moment 1
// check refuses a target whose world the contract does not declare. The
// distinction between the two CLI worlds is resolved by the guest's exports at
// load time (CLIH-06/CLIH-20), not by the build target — see the note in
// `framework-core`'s host configuration generator.
//
// Nothing in the framework may read this file at build time.

package clean:host@0.1.0;

/// Read-only access to the invoking process's environment (clean-cli §3.3).
interface env {
    /// Read an environment variable. None if unset.
    get: func(name: string) -> option<string>;

    /// All environment variables. Ordered as the host received them.
    all: func() -> list<tuple<string, string>>;

    /// Current working directory when clean-cli started.
    cwd: func() -> string;

    /// Whether stderr is a TTY (useful for color/spinner decisions).
    stderr-is-tty: func() -> bool;
}

/// The default-handler world (clean-cli §2.2, schema/cli.wit.md).
///
/// The guest receives the raw argv and does its own parsing. Declared from the
/// host's perspective, matching clean-cli's host.wit verbatim: `run` is an
/// import *of the host*, which is an export *of the guest*.
world cli-default {
    export env;

    /// Invoked with the raw argv (excluding the program name).
    ///
    /// Returns the process exit code (CLIH-11): 0 success, 1..=125
    /// guest-defined.
    import run: func(argv: list<string>, stdin-tty: bool) -> u8;
}

/// The named-subcommand world (clean-cli §2.1).
///
/// Declared so `wasm32-cli`'s world name resolves; clean-cli does not
/// implement this mode, and a guest exporting `commands` is refused at load.
world cli {
    export env;
}
